From a7284495f8eba90fa8bb09e15ce5dc11695ea8f9 Mon Sep 17 00:00:00 2001
From: SuYatBun <1665235918mj@gmail.com>
Date: Fri, 18 Sep 2026 01:07:38 +0800
Subject: [PATCH] Fix EU sound stopping a few seconds after boot

The EU build assembled sound/sequences/00_sound_player.s with the US
opcode layout, so the EU sequence player misread the script and drained
the global note pool, silencing everything shortly after startup.
Upstream issue: sm64pc/sm64ex#507.

make overwrites VERSION_ASFLAGS with "--defsym AVOID_UB=1" further down
the Makefile, discarding the "--defsym $(VERSION_DEF)=1" set earlier, so
the assembler never saw VERSION_EU. That made every .ifdef VERSION_*
block in include/seq_macros.inc and sound/sequences/00_sound_player.s
dead code, and the sequence was always built with the US opcodes:
chan_setnotepriority 14 became 0x6E (US 0x60 + a) instead of the EU 0xE9,
and chan_unreservenotes became 0xF1 instead of the EU 0xF0.

The EU engine decodes that stream by EU rules: 0x60 | n is a channel
delay that skips the rest of the channel script, and the following
F1 FB is chan_reservenotes 251, which makes note_pool_fill move the
whole global note pool into that single channel. With the global pool
empty, every later alloc_note fails for every sequence, so no music and
no sound effects are produced at all.

Append to VERSION_ASFLAGS instead of overwriting it, so the version
define reaches the assembler again.

Also include heap.h in port_eu.c, where audio_reset_session() is
declared: GCC 14 promoted the implicit declaration from a warning to an
error.
---
 Makefile            | 7 ++++++-
 src/audio/port_eu.c | 1 +
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 9012456..77db14c 100644
--- a/Makefile
+++ b/Makefile
@@ -222,7 +222,12 @@ ifeq ($(OSX_BUILD),1) # Modify GFX & SDL2 for OSX GL
      VERSION_CFLAGS += -DOSX_BUILD
 endif
 
-VERSION_ASFLAGS := --defsym AVOID_UB=1
+# NOTE: this used to be a plain assignment, which discarded the
+# "--defsym $(VERSION_DEF)=1" set above. As a result VERSION_JP/VERSION_EU were
+# never visible to the assembler, so the .ifdef VERSION_* blocks in
+# include/seq_macros.inc and sound/sequences/00_sound_player.s were dead and the
+# sound player sequence was always assembled with the US opcode layout.
+VERSION_ASFLAGS := $(VERSION_ASFLAGS) --defsym AVOID_UB=1
 COMPARE := 0
 
 ifeq ($(TARGET_WEB),1)
diff --git a/src/audio/port_eu.c b/src/audio/port_eu.c
index 4fbc74d..d2a763a 100644
--- a/src/audio/port_eu.c
+++ b/src/audio/port_eu.c
@@ -2,6 +2,7 @@
 #include "internal.h"
 #include "load.h"
 #include "data.h"
+#include "heap.h"
 #include "seqplayer.h"
 #include "synthesis.h"
 
-- 
